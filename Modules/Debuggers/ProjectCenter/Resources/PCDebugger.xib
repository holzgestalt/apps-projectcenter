            <value key="minSize" type="size" width="601" height="421"/>
            <value key="maxSize" type="size" width="9998" height="9967"/>
            <view key="contentView" id="g5">
                <rect key="frame" x="0.0" y="0.0" width="601" height="421"/>
                <autoresizingMask key="autoresizingMask" widthSizable="YES" heightSizable="YES"/>
                <subviews>
                    <scrollView borderType="bezel" horizontalLineScroll="10" horizontalPageScroll="10" verticalLineScroll="10" verticalPageScroll="10" hasHorizontalScroller="NO" hasVerticalScroller="YES" usesPredominantAxisScrolling="NO" id="g7" userLabel="ScrollView(0)">
                        <rect key="frame" x="0" y="0" width="600" height="400"/>
                        <autoresizingMask key="autoresizingMask" widthSizable="YES" heightSizable="YES"/>
                        <clipView key="contentView" drawsBackground="YES" copiesOnScroll="YES" id="g9">
                            <rect key="frame" x="21" y="2" width="577" height="396"/>
                            <autoresizingMask key="autoresizingMask" widthSizable="YES" heightSizable="YES"/>
                            <subviews>
