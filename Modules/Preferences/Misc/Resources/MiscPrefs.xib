<?xml version="1.0" encoding="UTF-8"?>
<document type="com.apple.InterfaceBuilder3.Cocoa.XIB" version="3.0" toolsVersion="25503" targetRuntime="MacOSX.Cocoa" propertyAccessControl="none" useAutolayout="NO">
    <dependencies>
        <plugIn identifier="com.apple.InterfaceBuilder.CocoaPlugin" version="25503"/>
        <capability name="documents saved in the Xcode 8 format" minToolsVersion="8.0"/>
    </dependencies>
    <objects>
        <customObject id="-2" userLabel="File's Owner" customClass="PCMiscPrefs">
            <connections>
                <outlet property="promptWhenQuit" destination="g54" id="x1"/>
                <outlet property="fullPathInFilePanels" destination="g64" id="x2"/>
                <outlet property="debuggerField" destination="g31" id="x3"/>
                <outlet property="debuggerButton" destination="g46" id="x4"/>
                <outlet property="editorField" destination="g36" id="x5"/>
                <outlet property="editorButton" destination="g40" id="x6"/>
                <outlet property="miscView" destination="g7" id="x7"/>
                <outlet property="rememberWindows" destination="g70" id="x8"/>
                <outlet property="displayLog" destination="g76" id="x9"/>
                <outlet property="useTearOffWindows" destination="g82" id="x10"/>
            </connections>
        </customObject>
        <customObject id="-1" userLabel="First Responder" customClass="FirstResponder"/>
        <customObject id="-3" userLabel="Application" customClass="NSObject"/>
        <window title="Misc" allowsToolTipsWhenApplicationIsInactive="NO" autorecalculatesKeyViewLoop="NO" releasedWhenClosed="NO" hidesOnDeactivate="YES" oneShot="NO" visibleAtLaunch="NO" animationBehavior="default" id="g3" userLabel="Misc Section" customClass="NSPanel">
            <windowStyleMask key="styleMask" titled="YES" closable="YES" resizable="YES"/>
            <windowPositionMask key="initialPositionMask" leftStrut="YES" bottomStrut="YES"/>
            <rect key="contentRect" x="1" y="9" width="368" height="295"/>
            <rect key="screenRect" x="0" y="0" width="1280" height="1024"/>
            <value key="minSize" type="size" width="3" height="33"/>
            <value key="maxSize" type="size" width="10000" height="10000"/>
            <view key="contentView" id="g5">
                <rect key="frame" x="0.0" y="0.0" width="368" height="295"/>
                <autoresizingMask key="autoresizingMask" widthSizable="YES" heightSizable="YES"/>
                <subviews>
                    <box title="Box" titlePosition="noTitle" id="g7">
                        <rect key="frame" x="0" y="0" width="334" height="263"/>
                        <autoresizingMask key="autoresizingMask"/>
                        <view key="contentView" id="g9">
                            <rect key="frame" x="2" y="2" width="330" height="259"/>
                            <autoresizingMask key="autoresizingMask"/>
                            <subviews>
                                <box title="External Tools" titlePosition="atTop" id="g11">
                                    <rect key="frame" x="10" y="15" width="310" height="87"/>
                                    <autoresizingMask key="autoresizingMask"/>
                                    <view key="contentView" id="g13">
                                        <rect key="frame" x="7" y="7" width="296" height="59"/>
                                        <autoresizingMask key="autoresizingMask"/>
                                        <subviews>
                                            <textField id="g15">
                                                <rect key="frame" x="0" y="31" width="59" height="21"/>
                                                <autoresizingMask key="autoresizingMask"/>
                                                <textFieldCell key="cell" lineBreakMode="wordWrapping" alignment="right" title="Debugger:" id="g17">
                                                    <font key="font" metaFont="system" size="12"/>
                                                    <color key="textColor" name="textColor" catalog="System" colorSpace="catalog"/>
                                                    <color key="backgroundColor" name="textBackgroundColor" catalog="System" colorSpace="catalog"/>
                                                </textFieldCell>
                                            </textField>
                                            <textField id="g27">
                                                <rect key="frame" x="0" y="4" width="59" height="21"/>
                                                <autoresizingMask key="autoresizingMask"/>
                                                <textFieldCell key="cell" lineBreakMode="wordWrapping" alignment="right" title="Editor:" id="g29">
                                                    <font key="font" metaFont="system" size="12"/>
                                                    <color key="textColor" name="textColor" catalog="System" colorSpace="catalog"/>
                                                    <color key="backgroundColor" name="textBackgroundColor" catalog="System" colorSpace="catalog"/>
                                                </textFieldCell>
                                            </textField>
                                            <textField id="g31">
                                                <rect key="frame" x="64" y="30" width="185" height="21"/>
                                                <autoresizingMask key="autoresizingMask"/>
                                                <textFieldCell key="cell" scrollable="YES" lineBreakMode="clipping" selectable="YES" editable="YES" borderStyle="bezel" alignment="left" title="" drawsBackground="YES" id="g33">
                                                    <font key="font" metaFont="system"/>
                                                    <color key="textColor" name="textColor" catalog="System" colorSpace="catalog"/>
                                                    <color key="backgroundColor" name="textBackgroundColor" catalog="System" colorSpace="catalog"/>
                                                </textFieldCell>
                                                <connections>
                                                    <action selector="setDebugger:" target="-2" id="x13"/>
                                                </connections>
                                            </textField>
                                            <textField id="g36">
                                                <rect key="frame" x="64" y="4" width="185" height="21"/>
                                                <autoresizingMask key="autoresizingMask"/>
                                                <textFieldCell key="cell" scrollable="YES" lineBreakMode="clipping" selectable="YES" editable="YES" borderStyle="bezel" alignment="left" title="" drawsBackground="YES" id="g38">
                                                    <font key="font" metaFont="system"/>
                                                    <color key="textColor" name="textColor" catalog="System" colorSpace="catalog"/>
                                                    <color key="backgroundColor" name="textBackgroundColor" catalog="System" colorSpace="catalog"/>
                                                </textFieldCell>
                                                <connections>
                                                    <action selector="setEditor:" target="-2" id="x15"/>
                                                </connections>
                                            </textField>
                                            <button id="g40">
                                                <rect key="frame" x="254" y="4" width="42" height="21"/>
                                                <autoresizingMask key="autoresizingMask"/>
                                                <buttonCell key="cell" type="push" title="Set..." imagePosition="noImage" bezelStyle="rounded" borderStyle="border" alignment="center" imageScaling="proportionallyDown" inset="2" id="g42">
                                                    <behavior key="behavior" lightByContents="YES" lightByGray="YES"/>
                                                    <font key="font" metaFont="system"/>
                                                    <modifierMask key="keyEquivalentModifierMask" command="YES"/>
                                                </buttonCell>
                                                <connections>
                                                    <action selector="setEditor:" target="-2" id="x16"/>
                                                </connections>
                                            </button>
                                            <button id="g46">
                                                <rect key="frame" x="254" y="30" width="42" height="21"/>
                                                <autoresizingMask key="autoresizingMask"/>
                                                <buttonCell key="cell" type="push" title="Set..." imagePosition="noImage" bezelStyle="rounded" borderStyle="border" alignment="center" imageScaling="proportionallyDown" inset="2" id="g48">
                                                    <behavior key="behavior" lightByContents="YES" lightByGray="YES"/>
                                                    <font key="font" metaFont="system"/>
                                                    <modifierMask key="keyEquivalentModifierMask" command="YES"/>
                                                </buttonCell>
                                                <connections>
                                                    <action selector="setDebugger:" target="-2" id="x14"/>
                                                </connections>
                                            </button>
                                        </subviews>
                                    </view>
                                    <font key="titleFont" metaFont="system"/>
                                </box>
                                <button id="g54">
                                    <rect key="frame" x="10" y="233" width="310" height="16"/>
                                    <autoresizingMask key="autoresizingMask"/>
                                    <buttonCell key="cell" type="check" title="Always prompt when quitting or closing project" imagePosition="left" alignment="left" inset="2" id="g56">
                                        <behavior key="behavior" changeContents="YES" doesNotDimImage="YES" lightByContents="YES"/>
                                        <font key="font" metaFont="system"/>
                                        <modifierMask key="keyEquivalentModifierMask" command="YES"/>
                                    </buttonCell>
                                    <connections>
                                        <action selector="setPromptWhenQuit:" target="-2" id="x11"/>
                                    </connections>
                                </button>
                                <button id="g64">
                                    <rect key="frame" x="10" y="212" width="310" height="16"/>
                                    <autoresizingMask key="autoresizingMask"/>
                                    <buttonCell key="cell" type="check" title="Select full path in Open Quickly panel" imagePosition="left" alignment="left" inset="2" id="g66">
                                        <behavior key="behavior" changeContents="YES" doesNotDimImage="YES" lightByContents="YES"/>
                                        <font key="font" metaFont="system"/>
                                        <modifierMask key="keyEquivalentModifierMask" command="YES"/>
                                    </buttonCell>
                                    <connections>
                                        <action selector="setFullPathInFilePanels:" target="-2" id="x12"/>
                                    </connections>
                                </button>
                                <button id="g70">
                                    <rect key="frame" x="10" y="191" width="310" height="16"/>
                                    <autoresizingMask key="autoresizingMask"/>
                                    <buttonCell key="cell" type="check" title="Remember windows and panels opened in project" imagePosition="left" alignment="left" state="on" inset="2" id="g72">
                                        <behavior key="behavior" changeContents="YES" doesNotDimImage="YES" lightByContents="YES"/>
                                        <font key="font" metaFont="system"/>
                                        <modifierMask key="keyEquivalentModifierMask" command="YES"/>
                                    </buttonCell>
                                    <connections>
                                        <action selector="setRememberWindows:" target="-2" id="x17"/>
                                    </connections>
                                </button>
                                <button id="g76">
                                    <rect key="frame" x="10" y="170" width="310" height="16"/>
                                    <autoresizingMask key="autoresizingMask"/>
                                    <buttonCell key="cell" type="check" title="Display Log Panel at startup" imagePosition="left" alignment="left" inset="2" id="g78">
                                        <behavior key="behavior" changeContents="YES" doesNotDimImage="YES" lightByContents="YES"/>
                                        <font key="font" metaFont="system"/>
                                        <modifierMask key="keyEquivalentModifierMask" command="YES"/>
                                    </buttonCell>
                                    <connections>
                                        <action selector="setDisplayLog:" target="-2" id="x18"/>
                                    </connections>
                                </button>
                                <button id="g82">
                                    <rect key="frame" x="10" y="149" width="312" height="16"/>
                                    <autoresizingMask key="autoresizingMask"/>
                                    <buttonCell key="cell" type="check" title="Use &quot;tear off&quot; windows for project tools" imagePosition="left" alignment="left" state="on" inset="2" id="g84">
                                        <behavior key="behavior" changeContents="YES" doesNotDimImage="YES" lightByContents="YES"/>
                                        <font key="font" metaFont="system"/>
                                        <modifierMask key="keyEquivalentModifierMask" command="YES"/>
                                    </buttonCell>
                                    <connections>
                                        <action selector="setUseTearOffWindows:" target="-2" id="x19"/>
                                    </connections>
                                </button>
                            </subviews>
                        </view>
                    </box>
                </subviews>
            </view>
        </window>
    </objects>
</document>