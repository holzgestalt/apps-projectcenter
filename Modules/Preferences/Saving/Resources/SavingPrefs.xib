<?xml version="1.0" encoding="UTF-8"?>
<document type="com.apple.InterfaceBuilder3.Cocoa.XIB" version="3.0" toolsVersion="25503" targetRuntime="MacOSX.Cocoa" propertyAccessControl="none" useAutolayout="NO">
    <dependencies>
        <plugIn identifier="com.apple.InterfaceBuilder.CocoaPlugin" version="25503"/>
        <capability name="documents saved in the Xcode 8 format" minToolsVersion="8.0"/>
    </dependencies>
    <objects>
        <customObject id="-2" userLabel="File's Owner" customClass="PCBuildPrefs">
            <connections>
                <outlet property="savingView" destination="g7" id="x1"/>
                <outlet property="saveOnQuit" destination="g15" id="x2"/>
                <outlet property="autosaveField" destination="g49" id="x3"/>
                <outlet property="keepBackup" destination="g26" id="x4"/>
                <outlet property="autosaveSlider" destination="g53" id="x5"/>
            </connections>
        </customObject>
        <customObject id="-1" userLabel="First Responder" customClass="FirstResponder"/>
        <customObject id="-3" userLabel="Application" customClass="NSObject"/>
        <window title="Build" allowsToolTipsWhenApplicationIsInactive="NO" autorecalculatesKeyViewLoop="NO" releasedWhenClosed="NO" hidesOnDeactivate="YES" oneShot="NO" visibleAtLaunch="NO" animationBehavior="default" id="g3" userLabel="Build Section" customClass="NSPanel">
            <windowStyleMask key="styleMask" titled="YES" closable="YES" resizable="YES"/>
            <windowPositionMask key="initialPositionMask" leftStrut="YES" bottomStrut="YES"/>
            <rect key="contentRect" x="1" y="9" width="368" height="295"/>
            <rect key="screenRect" x="0" y="0" width="1280" height="1024"/>
            <value key="minSize" type="size" width="3" height="33"/>
            <value key="maxSize" type="size" width="10000" height="10000"/>
            <view key="contentView" id="g5">
                <rect key="frame" x="0.0" y="0.0" width="368" height="295"/>
                <autoresizingMask key="autoresizingMask" widthSizable="YES" heightSizable="YES"/>
                <subviews>
                    <box title="Box" titlePosition="noTitle" id="g7">
                        <rect key="frame" x="0" y="0" width="334" height="263"/>
                        <autoresizingMask key="autoresizingMask"/>
                        <view key="contentView" id="g9">
                            <rect key="frame" x="2" y="2" width="330" height="259"/>
                            <autoresizingMask key="autoresizingMask"/>
                            <subviews>
                                <box title="Project Save Options" titlePosition="atTop" id="g11">
                                    <rect key="frame" x="18" y="157" width="294" height="92"/>
                                    <autoresizingMask key="autoresizingMask"/>
                                    <view key="contentView" id="g13">
                                        <rect key="frame" x="7" y="7" width="280" height="64"/>
                                        <autoresizingMask key="autoresizingMask"/>
                                        <subviews>
                                            <button id="g15">
                                                <rect key="frame" x="47" y="34" width="191" height="16"/>
                                                <autoresizingMask key="autoresizingMask"/>
                                                <buttonCell key="cell" type="check" title="Save Project Upon Quit" imagePosition="left" alignment="left" inset="2" id="g17">
                                                    <behavior key="behavior" changeContents="YES" doesNotDimImage="YES" lightByContents="YES"/>
                                                    <font key="font" metaFont="system"/>
                                                    <modifierMask key="keyEquivalentModifierMask" command="YES"/>
                                                </buttonCell>
                                                <connections>
                                                    <action selector="setSaveOnQuit:" target="-2" id="x6"/>
                                                </connections>
                                            </button>
                                            <button id="g26">
                                                <rect key="frame" x="47" y="13" width="191" height="16"/>
                                                <autoresizingMask key="autoresizingMask"/>
                                                <buttonCell key="cell" type="check" title="Keep Project Backup File" imagePosition="left" alignment="left" inset="2" id="g28">
                                                    <behavior key="behavior" changeContents="YES" doesNotDimImage="YES" lightByContents="YES"/>
                                                    <font key="font" metaFont="system"/>
                                                    <modifierMask key="keyEquivalentModifierMask" command="YES"/>
                                                </buttonCell>
                                                <connections>
                                                    <action selector="setKeepBackup:" target="-2" id="x7"/>
                                                </connections>
                                            </button>
                                        </subviews>
                                    </view>
                                    <font key="titleFont" metaFont="system"/>
                                </box>
                                <box title="Project Auto-Save Options" titlePosition="atTop" id="g34">
                                    <rect key="frame" x="18" y="63" width="294" height="89"/>
                                    <autoresizingMask key="autoresizingMask"/>
                                    <view key="contentView" id="g36">
                                        <rect key="frame" x="7" y="7" width="280" height="61"/>
                                        <autoresizingMask key="autoresizingMask"/>
                                        <subviews>
                                            <textField id="g38">
                                                <rect key="frame" x="10" y="3" width="260" height="18"/>
                                                <autoresizingMask key="autoresizingMask"/>
                                                <textFieldCell key="cell" lineBreakMode="wordWrapping" alignment="center" title="Frequency in Seconds" id="g40">
                                                    <font key="font" metaFont="system" size="12"/>
                                                    <color key="textColor" name="textColor" catalog="System" colorSpace="catalog"/>
                                                    <color key="backgroundColor" name="textBackgroundColor" catalog="System" colorSpace="catalog"/>
                                                </textFieldCell>
                                            </textField>
                                            <textField id="g49">
                                                <rect key="frame" x="10" y="44" width="260" height="18"/>
                                                <autoresizingMask key="autoresizingMask"/>
                                                <textFieldCell key="cell" lineBreakMode="wordWrapping" selectable="YES" alignment="center" title="120" id="g51">
                                                    <font key="font" metaFont="system"/>
                                                    <color key="textColor" name="textColor" catalog="System" colorSpace="catalog"/>
                                                    <color key="backgroundColor" name="textBackgroundColor" catalog="System" colorSpace="catalog"/>
                                                </textFieldCell>
                                                <connections>
                                                    <action selector="setSavePeriod:" target="-2" id="x9"/>
                                                </connections>
                                            </textField>
                                            <slider id="g53" userLabel="Slider(0)">
                                                <rect key="frame" x="10" y="26" width="260" height="18"/>
                                                <autoresizingMask key="autoresizingMask"/>
                                                <sliderCell key="cell" alignment="left" minValue="0" maxValue="120" tickMarkPosition="above" sliderType="linear" doubleValue="120" id="g55">
                                                    <font key="font" metaFont="system"/>
                                                </sliderCell>
                                                <connections>
                                                    <action selector="setSavePeriod:" target="-2" id="x8"/>
                                                </connections>
                                            </slider>
                                        </subviews>
                                    </view>
                                    <font key="titleFont" metaFont="system"/>
                                </box>
                            </subviews>
                        </view>
                    </box>
                </subviews>
            </view>
        </window>
    </objects>
</document>