<?xml version="1.0" encoding="UTF-8"?>
<document type="com.apple.InterfaceBuilder3.Cocoa.XIB" version="3.0" toolsVersion="25503" targetRuntime="MacOSX.Cocoa" propertyAccessControl="none" useAutolayout="NO">
    <dependencies>
        <plugIn identifier="com.apple.InterfaceBuilder.CocoaPlugin" version="25503"/>
        <capability name="documents saved in the Xcode 8 format" minToolsVersion="8.0"/>
    </dependencies>
    <objects>
        <customObject id="-2" userLabel="File's Owner" customClass="PCProjectManager">
            <connections>
                <outlet property="nsPanel" destination="g3" id="x1"/>
                <outlet property="nsImage" destination="g7" id="x2"/>
                <outlet property="nsTitle" destination="g24" id="x3"/>
                <outlet property="nsNameField" destination="g35" id="x4"/>
