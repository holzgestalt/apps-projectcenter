                <outlet property="nsCreateButton" destination="g76" id="x7"/>
                <outlet property="projectNameField" destination="g113" id="x8"/>
            </connections>
        </customObject>
        <customObject id="-1" userLabel="First Responder" customClass="FirstResponder"/>
        <customObject id="-3" userLabel="Application" customClass="NSObject"/>
        <window title="" allowsToolTipsWhenApplicationIsInactive="NO" autorecalculatesKeyViewLoop="NO" releasedWhenClosed="NO" oneShot="NO" visibleAtLaunch="NO" animationBehavior="default" id="g3" userLabel="NewSubproject" customClass="NSPanel">
            <windowStyleMask key="styleMask" titled="YES"/>
            <windowPositionMask key="initialPositionMask" leftStrut="YES" bottomStrut="YES"/>
            <rect key="contentRect" x="1" y="9" width="324" height="199"/>
            <rect key="screenRect" x="0" y="0" width="1280" height="1024"/>
            <value key="minSize" type="size" width="1" height="32"/>
            <value key="maxSize" type="size" width="10000" height="10000"/>
            <view key="contentView" id="g5">
                <rect key="frame" x="0.0" y="0.0" width="324" height="199"/>
                <autoresizingMask key="autoresizingMask" widthSizable="YES" heightSizable="YES"/>
                <subviews>
                    <imageView id="g7" userLabel="ImageView">
                        <rect key="frame" x="8" y="140" width="48" height="48"/>
                        <autoresizingMask key="autoresizingMask"/>
                        <imageCell key="cell" refusesFirstResponder="YES" alignment="left" imageScaling="none" id="g9"/>
                    </imageView>
                    <box title="Box" titlePosition="noTitle" id="g11" userLabel="Box">
                        <rect key="frame" x="0" y="130" width="324" height="2"/>
                        <autoresizingMask key="autoresizingMask"/>
                        <view key="contentView" id="g13">
                            <rect key="frame" x="7" y="7" width="310" height="0"/>
                            <autoresizingMask key="autoresizingMask"/>
                        </view>
                    </box>
                    <textField id="g24" userLabel="TextField">
                        <rect key="frame" x="66" y="153" width="248" height="35"/>
                        <autoresizingMask key="autoresizingMask"/>
                        <textFieldCell key="cell" lineBreakMode="wordWrapping" alignment="left" title="New Subproject" id="g26">
                            <font key="font" metaFont="systemBold" size="16"/>
                            <color key="textColor" name="textColor" catalog="System" colorSpace="catalog"/>
                            <color key="backgroundColor" name="textBackgroundColor" catalog="System" colorSpace="catalog"/>
                        </textFieldCell>
                    </textField>
                    <textField id="g35" userLabel="TextField1">
                        <rect key="frame" x="66" y="65" width="248" height="21"/>
                        <autoresizingMask key="autoresizingMask"/>
                        <textFieldCell key="cell" scrollable="YES" lineBreakMode="clipping" selectable="YES" editable="YES" borderStyle="bezel" alignment="left" title="" drawsBackground="YES" id="g37">
                            <font key="font" metaFont="system"/>
                            <color key="textColor" name="textColor" catalog="System" colorSpace="catalog"/>
                            <color key="backgroundColor" name="textBackgroundColor" catalog="System" colorSpace="catalog"/>
                        </textFieldCell>
                        <connections>
                            <outlet property="delegate" destination="-2" id="x11"/>
                        </connections>
                    </textField>
                    <textField id="g44" userLabel="TextField2">
                        <rect key="frame" x="5" y="65" width="56" height="21"/>
                        <autoresizingMask key="autoresizingMask"/>
                        <textFieldCell key="cell" lineBreakMode="wordWrapping" alignment="right" title="Name:" id="g46">
                            <font key="font" metaFont="system" size="12"/>
                            <color key="textColor" name="textColor" catalog="System" colorSpace="catalog"/>
                            <color key="backgroundColor" name="textBackgroundColor" catalog="System" colorSpace="catalog"/>
                        </textFieldCell>
