<?xml version="1.0" encoding="UTF-8"?>
<document type="com.apple.InterfaceBuilder3.Cocoa.XIB" version="3.0" toolsVersion="25503" targetRuntime="MacOSX.Cocoa" propertyAccessControl="none" useAutolayout="NO">
    <dependencies>
        <plugIn identifier="com.apple.InterfaceBuilder.CocoaPlugin" version="25503"/>
        <capability name="documents saved in the Xcode 8 format" minToolsVersion="8.0"/>
    </dependencies>
    <objects>
        <customObject id="-2" userLabel="File's Owner" customClass="PCProjectWindow">
            <connections>
                <outlet property="h_split" destination="g99" id="x2"/>
                <outlet property="fileIconTitle" destination="g16" id="x3"/>
                <outlet property="fileIcon" destination="g11" id="x4"/>
                <outlet property="projectWindow" destination="g3" id="x5"/>
                <outlet property="statusLine" destination="g101" id="x6"/>
                <outlet property="buildButton" destination="g84" id="x7"/>
                <outlet property="launchButton" destination="g27" id="x8"/>
                <outlet property="loadedFilesButton" destination="g44" id="x9"/>
                <outlet property="findButton" destination="g58" id="x10"/>
                <outlet property="inspectorButton" destination="g71" id="x11"/>
                <outlet property="toolbarView" destination="g7" id="x12"/>
            </connections>
        </customObject>
        <customObject id="-1" userLabel="First Responder" customClass="FirstResponder"/>
        <customObject id="-3" userLabel="Application" customClass="NSObject"/>
        <window title="Project Window" allowsToolTipsWhenApplicationIsInactive="NO" autorecalculatesKeyViewLoop="NO" releasedWhenClosed="NO" oneShot="NO" visibleAtLaunch="NO" animationBehavior="default" id="g3" userLabel="Window">
            <windowStyleMask key="styleMask" titled="YES" closable="YES" miniaturizable="YES" resizable="YES"/>
            <windowPositionMask key="initialPositionMask" leftStrut="YES" bottomStrut="YES"/>
            <rect key="contentRect" x="1" y="9" width="560" height="468"/>
            <rect key="screenRect" x="0" y="0" width="1024" height="768"/>
            <value key="minSize" type="size" width="500" height="430"/>
            <value key="maxSize" type="size" width="10000" height="10000"/>
            <view key="contentView" id="g5">
                <rect key="frame" x="0.0" y="0.0" width="560" height="468"/>
                <autoresizingMask key="autoresizingMask" widthSizable="YES" heightSizable="YES"/>
                <subviews>
                    <box title="Box" titlePosition="noTitle" boxType="custom" borderType="none" id="g7" userLabel="Box">
                        <rect key="frame" x="8" y="415" width="544" height="57"/>
                        <autoresizingMask key="autoresizingMask" widthSizable="YES" flexibleMinY="YES"/>
                        <view key="contentView" id="g9">
                            <rect key="frame" x="0" y="0" width="544" height="57"/>
                            <autoresizingMask key="autoresizingMask"/>
                            <subviews>
                                <imageView id="g11" userLabel="ImageView" customClass="PCFileNameIcon">
                                    <rect key="frame" x="489" y="0" width="50" height="50"/>
                                    <autoresizingMask key="autoresizingMask" flexibleMinX="YES"/>
                                    <imageCell key="cell" refusesFirstResponder="YES" alignment="left" imageScaling="none" id="g14"/>
                                </imageView>
                                <textField id="g16" userLabel="TextField">
                                    <rect key="frame" x="224" y="0" width="260" height="17"/>
                                    <autoresizingMask key="autoresizingMask" flexibleMinX="YES" widthSizable="YES"/>
                                    <textFieldCell key="cell" lineBreakMode="wordWrapping" alignment="right" title="Project" drawsBackground="YES" id="g18">
                                        <font key="font" metaFont="system"/>
                                        <color key="textColor" name="textColor" catalog="System" colorSpace="catalog"/>
                                        <color key="backgroundColor" name="windowBackgroundColor" catalog="System" colorSpace="catalog"/>
                                    </textFieldCell>
                                </textField>
                                <button id="g27" userLabel="Button1" customClass="PCButton">
                                    <rect key="frame" x="44" y="1" width="44" height="43"/>
                                    <autoresizingMask key="autoresizingMask"/>
                                    <buttonCell key="cell" type="push" title="Button" imagePosition="noImage" bezelStyle="regularSquare" borderStyle="border" alignment="center" imageScaling="proportionallyDown" inset="2" id="g30">
                                        <behavior key="behavior" lightByContents="YES" lightByGray="YES"/>
                                        <font key="font" metaFont="system"/>
                                    </buttonCell>
                                    <connections>
                                        <action selector="showProjectLaunch:" target="-2" id="x14"/>
                                    </connections>
                                </button>
                                <button id="g44" userLabel="Button2" customClass="PCButton">
                                    <rect key="frame" x="88" y="1" width="43" height="43"/>
                                    <autoresizingMask key="autoresizingMask"/>
                                    <buttonCell key="cell" type="push" title="Button" imagePosition="noImage" bezelStyle="regularSquare" borderStyle="border" alignment="center" imageScaling="proportionallyDown" inset="2" id="g47">
                                        <behavior key="behavior" lightByContents="YES" lightByGray="YES"/>
                                        <font key="font" metaFont="system"/>
                                    </buttonCell>
                                    <connections>
                                        <action selector="showProjectLoadedFiles:" target="-2" id="x15"/>
                                    </connections>
                                </button>
                                <button id="g58" userLabel="Button3" customClass="PCButton">
                                    <rect key="frame" x="132" y="1" width="43" height="43"/>
                                    <autoresizingMask key="autoresizingMask"/>
                                    <buttonCell key="cell" type="push" title="Button" imagePosition="noImage" bezelStyle="regularSquare" borderStyle="border" alignment="center" imageScaling="proportionallyDown" inset="2" id="g61">
                                        <behavior key="behavior" lightByContents="YES" lightByGray="YES"/>
                                        <font key="font" metaFont="system"/>
                                    </buttonCell>
                                    <connections>
                                        <action selector="showFindView:" target="-2" id="x16"/>
                                    </connections>
                                </button>
                                <button id="g71" userLabel="Button4" customClass="PCButton">
                                    <rect key="frame" x="176" y="1" width="43" height="43"/>
                                    <autoresizingMask key="autoresizingMask"/>
                                    <buttonCell key="cell" type="push" title="Button" imagePosition="noImage" bezelStyle="regularSquare" borderStyle="border" alignment="center" imageScaling="proportionallyDown" inset="2" id="g74">
                                        <behavior key="behavior" lightByContents="YES" lightByGray="YES"/>
                                        <font key="font" metaFont="system"/>
                                    </buttonCell>
                                    <connections>
                                        <action selector="showProjectInspector:" target="-2" id="x17"/>
                                    </connections>
                                </button>
                                <button id="g84" userLabel="Button" customClass="PCButton">
                                    <rect key="frame" x="0" y="1" width="44" height="43"/>
                                    <autoresizingMask key="autoresizingMask"/>
                                    <buttonCell key="cell" type="push" title="Button" imagePosition="noImage" bezelStyle="regularSquare" borderStyle="border" alignment="center" imageScaling="proportionallyDown" inset="2" id="g87">
                                        <behavior key="behavior" lightByContents="YES" lightByGray="YES"/>
                                        <font key="font" metaFont="system"/>
                                    </buttonCell>
                                    <connections>
                                        <action selector="showProjectBuild:" target="-2" id="x13"/>
                                    </connections>
                                </button>
                            </subviews>
                        </view>
                        <color key="borderColor" white="0" alpha="0" colorSpace="calibratedWhite"/>
                        <color key="fillColor" white="0" alpha="0" colorSpace="calibratedWhite"/>
                    </box>
                    <customView id="g99" userLabel="GormCustomView" customClass="NSSplitView">
                        <rect key="frame" x="8" y="-2" width="544" height="399"/>
                        <autoresizingMask key="autoresizingMask" widthSizable="YES" heightSizable="YES"/>
                    </customView>
                    <textField id="g101" userLabel="TextField1">
                        <rect key="frame" x="8" y="400" width="352" height="12"/>
                        <autoresizingMask key="autoresizingMask" widthSizable="YES" flexibleMinY="YES"/>
                        <textFieldCell key="cell" lineBreakMode="wordWrapping" alignment="left" title="Status line" drawsBackground="YES" id="g103">
                            <font key="font" metaFont="toolTip" size="11"/>
                            <color key="textColor" white="0.333333" alpha="1" colorSpace="calibratedWhite"/>
                            <color key="backgroundColor" name="windowBackgroundColor" catalog="System" colorSpace="catalog"/>
                        </textFieldCell>
                    </textField>
                </subviews>
            </view>
            <connections>
                <outlet property="delegate" destination="-2" id="x1"/>
            </connections>
        </window>
    </objects>
</document>