<?xml version="1.0" encoding="UTF-8"?>
<document type="com.apple.InterfaceBuilder3.Cocoa.XIB" version="3.0" toolsVersion="25503" targetRuntime="MacOSX.Cocoa" propertyAccessControl="none" useAutolayout="NO">
    <dependencies>
        <plugIn identifier="com.apple.InterfaceBuilder.CocoaPlugin" version="25503"/>
        <capability name="documents saved in the Xcode 8 format" minToolsVersion="8.0"/>
    </dependencies>
    <objects>
        <customObject id="-2" userLabel="File's Owner" customClass="PCProjectBuilder">
            <connections>
                <outlet property="buildButton" destination="g11" id="x1"/>
                <outlet property="cleanButton" destination="g26" id="x2"/>
                <outlet property="optionsButton" destination="g38" id="x3"/>
                <outlet property="componentView" destination="g7" id="x4"/>
                <outlet property="split" destination="g47" id="x5"/>
                <outlet property="targetField" destination="g69" id="x6"/>
                <outlet property="errorsCountField" destination="g87" id="x7"/>
                <outlet property="statusField" destination="g78" id="x8"/>
            </connections>
        </customObject>
        <customObject id="-1" userLabel="First Responder" customClass="FirstResponder"/>
        <customObject id="-3" userLabel="Application" customClass="NSObject"/>
        <window title="Project Build" allowsToolTipsWhenApplicationIsInactive="NO" autorecalculatesKeyViewLoop="NO" releasedWhenClosed="NO" oneShot="NO" visibleAtLaunch="NO" animationBehavior="default" id="g3" userLabel="Window">
            <windowStyleMask key="styleMask" titled="YES" closable="YES" miniaturizable="YES" resizable="YES"/>
            <windowPositionMask key="initialPositionMask" leftStrut="YES" bottomStrut="YES"/>
            <rect key="contentRect" x="1" y="9" width="560" height="448"/>
            <rect key="screenRect" x="0" y="0" width="1024" height="768"/>
            <value key="minSize" type="size" width="1" height="1"/>
            <value key="maxSize" type="size" width="10000" height="10000"/>
            <view key="contentView" id="g5">
                <rect key="frame" x="0.0" y="0.0" width="560" height="448"/>
                <autoresizingMask key="autoresizingMask" widthSizable="YES" heightSizable="YES"/>
                <subviews>
                    <box title="Box" titlePosition="noTitle" boxType="custom" borderType="none" id="g7">
                        <rect key="frame" x="29" y="55" width="464" height="345"/>
                        <autoresizingMask key="autoresizingMask" widthSizable="YES" heightSizable="YES"/>
                        <view key="contentView" id="g9">
                            <rect key="frame" x="0" y="0" width="464" height="345"/>
                            <autoresizingMask key="autoresizingMask"/>
                            <subviews>
                                <button id="g11" customClass="PCButton">
                                    <rect key="frame" x="0" y="302" width="38" height="32"/>
                                    <autoresizingMask key="autoresizingMask" flexibleMaxX="YES" flexibleMinY="YES"/>
                                    <buttonCell key="cell" type="push" title="Build" imagePosition="noImage" bezelStyle="rounded" borderStyle="border" alignment="center" imageScaling="proportionallyDown" inset="2" id="g14">
                                        <behavior key="behavior" pushIn="YES" lightByContents="YES"/>
                                        <font key="font" metaFont="system"/>
                                        <modifierMask key="keyEquivalentModifierMask" command="YES"/>
                                    </buttonCell>
                                    <connections>
                                        <action selector="startBuild:" target="-2" id="x9"/>
                                    </connections>
                                </button>
                                <button id="g26" customClass="PCButton">
                                    <rect key="frame" x="43" y="302" width="38" height="32"/>
                                    <autoresizingMask key="autoresizingMask" flexibleMaxX="YES" flexibleMinY="YES"/>
                                    <buttonCell key="cell" type="push" title="Clean" imagePosition="noImage" bezelStyle="rounded" borderStyle="border" alignment="center" imageScaling="proportionallyDown" inset="2" id="g29">
                                        <behavior key="behavior" pushIn="YES" lightByContents="YES"/>
                                        <font key="font" metaFont="system"/>
                                        <modifierMask key="keyEquivalentModifierMask" command="YES"/>
                                    </buttonCell>
                                    <connections>
                                        <action selector="startClean:" target="-2" id="x10"/>
                                    </connections>
                                </button>
                                <button id="g38" customClass="PCButton">
                                    <rect key="frame" x="86" y="302" width="38" height="32"/>
                                    <autoresizingMask key="autoresizingMask" flexibleMaxX="YES" flexibleMinY="YES"/>
                                    <buttonCell key="cell" type="push" title="Build Options" imagePosition="noImage" bezelStyle="rounded" borderStyle="border" alignment="center" imageScaling="proportionallyDown" inset="2" id="g41">
                                        <behavior key="behavior" lightByContents="YES" lightByGray="YES"/>
                                        <font key="font" metaFont="system"/>
                                        <modifierMask key="keyEquivalentModifierMask" command="YES"/>
                                    </buttonCell>
                                    <connections>
                                        <action selector="showOptionsPanel:" target="-2" id="x11"/>
                                    </connections>
                                </button>
                                <customView id="g47" customClass="NSSplitView">
                                    <rect key="frame" x="0" y="-2" width="464" height="281"/>
                                    <autoresizingMask key="autoresizingMask" widthSizable="YES" heightSizable="YES"/>
                                </customView>
                                <textField id="g49">
                                    <rect key="frame" x="139" y="320" width="58" height="18"/>
                                    <autoresizingMask key="autoresizingMask" flexibleMaxX="YES" flexibleMinY="YES"/>
                                    <textFieldCell key="cell" alignment="right" title="Target" id="g51">
                                        <font key="font" metaFont="system" size="12"/>
                                        <color key="textColor" name="secondaryLabelColor" catalog="System" colorSpace="catalog"/>
                                        <color key="backgroundColor" name="textBackgroundColor" catalog="System" colorSpace="catalog"/>
                                    </textFieldCell>
                                </textField>
                                <textField id="g60">
                                    <rect key="frame" x="139" y="298" width="58" height="18"/>
                                    <autoresizingMask key="autoresizingMask" flexibleMaxX="YES" flexibleMinY="YES"/>
                                    <textFieldCell key="cell" alignment="right" title="Status" id="g62">
                                        <font key="font" metaFont="system" size="12"/>
                                        <color key="textColor" name="secondaryLabelColor" catalog="System" colorSpace="catalog"/>
                                        <color key="backgroundColor" name="textBackgroundColor" catalog="System" colorSpace="catalog"/>
                                    </textFieldCell>
                                </textField>
                                <textField id="g69">
                                    <rect key="frame" x="204" y="320" width="260" height="18"/>
                                    <autoresizingMask key="autoresizingMask" widthSizable="YES" flexibleMinY="YES"/>
                                    <textFieldCell key="cell" lineBreakMode="truncatingTail" alignment="left" title="" id="g71">
                                        <font key="font" metaFont="system" size="12"/>
                                        <color key="textColor" name="textColor" catalog="System" colorSpace="catalog"/>
                                        <color key="backgroundColor" name="textBackgroundColor" catalog="System" colorSpace="catalog"/>
                                    </textFieldCell>
                                </textField>
                                <textField id="g78">
                                    <rect key="frame" x="204" y="298" width="260" height="18"/>
                                    <autoresizingMask key="autoresizingMask" widthSizable="YES" flexibleMinY="YES"/>
                                    <textFieldCell key="cell" lineBreakMode="truncatingTail" alignment="left" title="Ready" id="g80">
                                        <font key="font" metaFont="system" size="12"/>
                                        <color key="textColor" name="textColor" catalog="System" colorSpace="catalog"/>
                                        <color key="backgroundColor" name="textBackgroundColor" catalog="System" colorSpace="catalog"/>
                                    </textFieldCell>
                                </textField>
                                <textField id="g87">
                                    <rect key="frame" x="0" y="279" width="176" height="16"/>
                                    <autoresizingMask key="autoresizingMask" widthSizable="YES" flexibleMinY="YES"/>
                                    <textFieldCell key="cell" lineBreakMode="wordWrapping" alignment="left" title="Warnings and errors" drawsBackground="YES" id="g89">
                                        <font key="font" metaFont="toolTip" size="11"/>
                                        <color key="textColor" name="textColor" catalog="System" colorSpace="catalog"/>
                                        <color key="backgroundColor" name="windowBackgroundColor" catalog="System" colorSpace="catalog"/>
                                    </textFieldCell>
                                </textField>
                            </subviews>
                        </view>
                        <color key="borderColor" white="0" alpha="0" colorSpace="calibratedWhite"/>
                        <color key="fillColor" white="0" alpha="0" colorSpace="calibratedWhite"/>
                    </box>
                </subviews>
            </view>
        </window>
    </objects>
</document>
