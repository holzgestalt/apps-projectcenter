        <window title="Build Options" allowsToolTipsWhenApplicationIsInactive="NO" autorecalculatesKeyViewLoop="NO" releasedWhenClosed="NO" hidesOnDeactivate="YES" oneShot="NO" visibleAtLaunch="NO" animationBehavior="default" id="g3" userLabel="Panel(0)" customClass="NSPanel">
            <windowStyleMask key="styleMask" titled="YES" closable="YES"/>
