<?xml version="1.0" encoding="UTF-8"?>
<document type="com.apple.InterfaceBuilder3.Cocoa.XIB" version="3.0" toolsVersion="25503" targetRuntime="MacOSX.Cocoa" propertyAccessControl="none" useAutolayout="NO">
    <dependencies>
        <plugIn identifier="com.apple.InterfaceBuilder.CocoaPlugin" version="25503"/>
        <capability name="documents saved in the Xcode 8 format" minToolsVersion="8.0"/>
    </dependencies>
    <objects>
        <customObject id="-2" userLabel="File's Owner" customClass="PCProjectInspector">
            <connections>
                <outlet property="inspectorPanel" destination="g3" id="x1"/>
                <outlet property="contentView" destination="g7" id="x2"/>
                <outlet property="inspectorPopup" destination="g11" id="x3"/>
                <outlet property="inspectorView" destination="g34" id="x4"/>
            </connections>
        </customObject>
        <customObject id="-1" userLabel="First Responder" customClass="FirstResponder"/>
        <customObject id="-3" userLabel="Application" customClass="NSObject"/>
        <window title="Project Inspector" allowsToolTipsWhenApplicationIsInactive="NO" autorecalculatesKeyViewLoop="NO" releasedWhenClosed="NO" oneShot="NO" visibleAtLaunch="NO" animationBehavior="default" id="g3" userLabel="Inspector" customClass="NSPanel">
            <windowStyleMask key="styleMask" titled="YES" closable="YES"/>
            <windowPositionMask key="initialPositionMask" leftStrut="YES" bottomStrut="YES"/>
            <rect key="contentRect" x="5" y="5" width="300" height="415"/>
            <rect key="screenRect" x="0" y="0" width="1024" height="768"/>
            <value key="minSize" type="size" width="300" height="415"/>
            <value key="maxSize" type="size" width="10000" height="10000"/>
            <view key="contentView" id="g5">
                <rect key="frame" x="0.0" y="0.0" width="300" height="415"/>
                <autoresizingMask key="autoresizingMask" widthSizable="YES" heightSizable="YES"/>
                <subviews>
                    <box title="contentView" titlePosition="noTitle" boxType="custom" borderType="none" id="g7" userLabel="Box">
                        <rect key="frame" x="0" y="0" width="300" height="410"/>
                        <autoresizingMask key="autoresizingMask"/>
                        <view key="contentView" id="g9">
                            <rect key="frame" x="0" y="0" width="300" height="410"/>
                            <autoresizingMask key="autoresizingMask"/>
                            <subviews>
                                <popUpButton id="g11" userLabel="GormNSPopUpButton">
                                    <rect key="frame" x="81" y="386" width="138" height="20"/>
                                    <autoresizingMask key="autoresizingMask"/>
                                    <popUpButtonCell key="cell" type="push" bezelStyle="rounded" alignment="left" lineBreakMode="truncatingTail" borderStyle="borderAndBezel" imageScaling="proportionallyDown" inset="2" id="g13">
                                        <behavior key="behavior" lightByBackground="YES" lightByGray="YES"/>
                                        <font key="font" metaFont="system"/>
                                        <menu key="menu" title="" id="g16">
                                            <items>
                                                <menuItem title="Build Attributes" id="g19" userLabel="MenuItem"/>
                                                <menuItem title="Project Attributes" id="g22" userLabel="MenuItem1"/>
                                                <menuItem title="Project Description" id="g24" userLabel="MenuItem2"/>
                                                <menuItem title="Project Languages" id="g26"/>
                                                <menuItem title="File Attributes" id="g29" userLabel="MenuItem3"/>
                                            </items>
                                        </menu>
                                    </popUpButtonCell>
                                    <connections>
                                        <action selector="inspectorPopupDidChange:" target="-2" id="x5"/>
                                    </connections>
                                </popUpButton>
                                <box title="inspectorView" titlePosition="noTitle" boxType="custom" borderType="none" id="g34" userLabel="Box1">
                                    <rect key="frame" x="-2" y="-2" width="304" height="380"/>
                                    <autoresizingMask key="autoresizingMask"/>
                                    <view key="contentView" id="g36">
                                        <rect key="frame" x="0" y="0" width="304" height="380"/>
                                        <autoresizingMask key="autoresizingMask"/>
                                    </view>
                                    <color key="borderColor" white="0" alpha="0" colorSpace="calibratedWhite"/>
                                    <color key="fillColor" white="0" alpha="0" colorSpace="calibratedWhite"/>
                                </box>
                            </subviews>
                        </view>
                        <color key="borderColor" white="0" alpha="0" colorSpace="calibratedWhite"/>
                        <color key="fillColor" white="0" alpha="0" colorSpace="calibratedWhite"/>
                    </box>
                </subviews>
            </view>
        </window>
    </objects>
</document>