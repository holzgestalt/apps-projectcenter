<?xml version="1.0" encoding="UTF-8"?>
<document type="com.apple.InterfaceBuilder3.Cocoa.XIB" version="3.0" toolsVersion="25503" targetRuntime="MacOSX.Cocoa" propertyAccessControl="none" useAutolayout="NO">
    <dependencies>
        <plugIn identifier="com.apple.InterfaceBuilder.CocoaPlugin" version="25503"/>
        <capability name="documents saved in the Xcode 8 format" minToolsVersion="8.0"/>
    </dependencies>
    <objects>
        <customObject id="-2" userLabel="File's Owner" customClass="PCProjectInspector">
            <connections>
                <outlet property="fileAttributesView" destination="g7" id="x1"/>
                <outlet property="fileNameField" destination="g16" id="x2"/>
                <outlet property="fileIconView" destination="g11" id="x3"/>
                <outlet property="localizableButton" destination="g35" id="x4"/>
                <outlet property="publicHeaderButton" destination="g45" id="x5"/>
            </connections>
        </customObject>
        <customObject id="-1" userLabel="First Responder" customClass="FirstResponder"/>
        <customObject id="-3" userLabel="Application" customClass="NSObject"/>
        <window title="Panel" allowsToolTipsWhenApplicationIsInactive="NO" autorecalculatesKeyViewLoop="NO" releasedWhenClosed="NO" hidesOnDeactivate="YES" oneShot="NO" visibleAtLaunch="NO" animationBehavior="default" id="g3" userLabel="GormNSPanel" customClass="NSPanel">
            <windowStyleMask key="styleMask" titled="YES" closable="YES" resizable="YES"/>
            <windowPositionMask key="initialPositionMask" leftStrut="YES" bottomStrut="YES"/>
            <rect key="contentRect" x="1" y="9" width="361" height="435"/>
            <rect key="screenRect" x="0" y="0" width="1280" height="1024"/>
            <value key="minSize" type="size" width="1" height="32"/>
            <value key="maxSize" type="size" width="10000" height="10000"/>
            <view key="contentView" id="g5">
                <rect key="frame" x="0.0" y="0.0" width="361" height="435"/>
                <autoresizingMask key="autoresizingMask" widthSizable="YES" heightSizable="YES"/>
                <subviews>
                    <box title="FileAttributes" titlePosition="noTitle" id="g7" userLabel="Box">
                        <rect key="frame" x="0" y="0" width="315" height="384"/>
                        <autoresizingMask key="autoresizingMask"/>
                        <view key="contentView" id="g9">
                            <rect key="frame" x="2" y="2" width="311" height="380"/>
                            <autoresizingMask key="autoresizingMask"/>
                            <subviews>
                                <imageView id="g11" userLabel="ImageView" customClass="PCFileNameIcon">
                                    <rect key="frame" x="10" y="322" width="48" height="48"/>
                                    <autoresizingMask key="autoresizingMask"/>
                                    <imageCell key="cell" refusesFirstResponder="YES" alignment="left" imageScaling="none" id="g14"/>
                                </imageView>
                                <textField id="g16" userLabel="TextField" customClass="PCFileNameField">
                                    <rect key="frame" x="63" y="322" width="230" height="48"/>
                                    <autoresizingMask key="autoresizingMask"/>
                                    <textFieldCell key="cell" scrollable="YES" lineBreakMode="clipping" alignment="left" title="No files selected" drawsBackground="YES" id="g19">
                                        <font key="font" metaFont="system" size="18"/>
                                        <color key="textColor" name="textColor" catalog="System" colorSpace="catalog"/>
                                        <color key="backgroundColor" white="0.666667" alpha="1" colorSpace="calibratedWhite"/>
                                    </textFieldCell>
                                    <connections>
                                        <action selector="fileNameDidChange:" target="-2" id="x6"/>
                                        <outlet property="delegate" destination="-2" id="x7"/>
                                    </connections>
                                </textField>
                                <box title="Box" titlePosition="noTitle" id="g29" userLabel="Box1">
                                    <rect key="frame" x="0" y="315" width="311" height="2"/>
                                    <autoresizingMask key="autoresizingMask"/>
                                    <view key="contentView" id="g31">
                                        <rect key="frame" x="2" y="2" width="307" height="0"/>
                                        <autoresizingMask key="autoresizingMask"/>
                                    </view>
                                </box>
                                <button id="g35" userLabel="Button" enabled="NO">
                                    <rect key="frame" x="63" y="275" width="144" height="21"/>
                                    <autoresizingMask key="autoresizingMask"/>
                                    <buttonCell key="cell" type="check" title="Localizable Resource" imagePosition="left" alignment="left" inset="2" id="g37">
                                        <behavior key="behavior" changeContents="YES" doesNotDimImage="YES" lightByContents="YES"/>
                                        <font key="font" metaFont="system"/>
                                        <modifierMask key="keyEquivalentModifierMask" command="YES"/>
                                    </buttonCell>
                                    <connections>
                                        <action selector="setLocalizableResource:" target="-2" id="x9"/>
                                    </connections>
                                </button>
                                <button id="g45" userLabel="Button1" enabled="NO">
                                    <rect key="frame" x="63" y="254" width="144" height="21"/>
                                    <autoresizingMask key="autoresizingMask"/>
                                    <buttonCell key="cell" type="check" title="Public Header" imagePosition="left" alignment="left" inset="2" id="g47">
                                        <behavior key="behavior" changeContents="YES" doesNotDimImage="YES" lightByContents="YES"/>
                                        <font key="font" metaFont="system"/>
                                        <modifierMask key="keyEquivalentModifierMask" command="YES"/>
                                    </buttonCell>
                                    <connections>
                                        <action selector="setPublicHeader:" target="-2" id="x8"/>
                                    </connections>
                                </button>
                            </subviews>
                        </view>
                    </box>
                </subviews>
            </view>
        </window>
    </objects>
</document>