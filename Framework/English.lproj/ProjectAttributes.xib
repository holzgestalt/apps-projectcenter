<?xml version="1.0" encoding="UTF-8"?>
<document type="com.apple.InterfaceBuilder3.Cocoa.XIB" version="3.0" toolsVersion="25503" targetRuntime="MacOSX.Cocoa" propertyAccessControl="none" useAutolayout="NO">
    <dependencies>
        <plugIn identifier="com.apple.InterfaceBuilder.CocoaPlugin" version="25503"/>
        <capability name="documents saved in the Xcode 8 format" minToolsVersion="8.0"/>
    </dependencies>
    <objects>
        <customObject id="-2" userLabel="File's Owner" customClass="PCProjectInspector">
            <connections>
                <outlet property="projectTypeField" destination="g22" id="x1"/>
                <outlet property="projectNameField" destination="g34" id="x2"/>
                <outlet property="projectLanguagePB" destination="g43" id="x3"/>
                <outlet property="projectAttributesView" destination="g7" id="x4"/>
            </connections>
        </customObject>
        <customObject id="-1" userLabel="First Responder" customClass="FirstResponder"/>
        <customObject id="-3" userLabel="Application" customClass="NSObject"/>
        <window title="Panel" allowsToolTipsWhenApplicationIsInactive="NO" autorecalculatesKeyViewLoop="NO" releasedWhenClosed="NO" hidesOnDeactivate="YES" oneShot="NO" visibleAtLaunch="NO" animationBehavior="default" id="g3" userLabel="Inspector" customClass="NSPanel">
            <windowStyleMask key="styleMask" titled="YES" closable="YES" resizable="YES"/>
            <windowPositionMask key="initialPositionMask" leftStrut="YES" bottomStrut="YES"/>
            <rect key="contentRect" x="1" y="9" width="342" height="408"/>
            <rect key="screenRect" x="0" y="0" width="1600" height="860"/>
            <value key="minSize" type="size" width="-1" height="-31"/>
            <value key="maxSize" type="size" width="9998" height="9968"/>
            <view key="contentView" id="g5">
                <rect key="frame" x="0.0" y="0.0" width="342" height="408"/>
                <autoresizingMask key="autoresizingMask" widthSizable="YES" heightSizable="YES"/>
                <subviews>
                    <box title="projectAttributesView" titlePosition="noTitle" id="g7" userLabel="Box">
                        <rect key="frame" x="-6" y="-6" width="315" height="384"/>
                        <autoresizingMask key="autoresizingMask"/>
                        <view key="contentView" id="g9" userLabel="View">
                            <rect key="frame" x="2" y="2" width="311" height="380"/>
                            <autoresizingMask key="autoresizingMask"/>
                            <subviews>
                                <textField id="g11" userLabel="TextField">
                                    <rect key="frame" x="9" y="348" width="104" height="21"/>
                                    <autoresizingMask key="autoresizingMask"/>
                                    <textFieldCell key="cell" lineBreakMode="wordWrapping" alignment="right" title="Project Type:" id="g13">
                                        <font key="font" metaFont="system" size="12"/>
                                        <color key="textColor" name="textColor" catalog="System" colorSpace="catalog"/>
                                        <color key="backgroundColor" name="textBackgroundColor" catalog="System" colorSpace="catalog"/>
                                    </textFieldCell>
                                </textField>
                                <textField id="g22" userLabel="TextField1">
                                    <rect key="frame" x="120" y="349" width="174" height="21"/>
                                    <autoresizingMask key="autoresizingMask"/>
                                    <textFieldCell key="cell" lineBreakMode="wordWrapping" alignment="left" title="__________________________" drawsBackground="YES" id="g24">
                                        <font key="font" metaFont="systemBold" size="12"/>
                                        <color key="textColor" name="textColor" catalog="System" colorSpace="catalog"/>
                                        <color key="backgroundColor" white="0.666667" alpha="1" colorSpace="calibratedWhite"/>
                                    </textFieldCell>
                                </textField>
                                <textField id="g30" userLabel="TextField2">
                                    <rect key="frame" x="9" y="322" width="104" height="21"/>
                                    <autoresizingMask key="autoresizingMask"/>
                                    <textFieldCell key="cell" lineBreakMode="wordWrapping" alignment="right" title="Project Name:" id="g32">
                                        <font key="font" metaFont="system" size="12"/>
                                        <color key="textColor" name="textColor" catalog="System" colorSpace="catalog"/>
                                        <color key="backgroundColor" name="textBackgroundColor" catalog="System" colorSpace="catalog"/>
                                    </textFieldCell>
                                </textField>
                                <textField id="g34" userLabel="TextField3">
                                    <rect key="frame" x="120" y="326" width="174" height="21"/>
                                    <autoresizingMask key="autoresizingMask"/>
                                    <textFieldCell key="cell" scrollable="YES" lineBreakMode="clipping" selectable="YES" borderStyle="bezel" alignment="left" title="" drawsBackground="YES" id="g36">
                                        <font key="font" metaFont="system"/>
                                        <color key="textColor" name="textColor" catalog="System" colorSpace="catalog"/>
                                        <color key="backgroundColor" name="textBackgroundColor" catalog="System" colorSpace="catalog"/>
                                    </textFieldCell>
                                </textField>
                                <textField id="g39" userLabel="TextField4">
                                    <rect key="frame" x="9" y="298" width="104" height="21"/>
                                    <autoresizingMask key="autoresizingMask"/>
                                    <textFieldCell key="cell" lineBreakMode="wordWrapping" alignment="right" title="Language:" id="g41">
                                        <font key="font" metaFont="system" size="12"/>
                                        <color key="textColor" name="textColor" catalog="System" colorSpace="catalog"/>
                                        <color key="backgroundColor" name="textBackgroundColor" catalog="System" colorSpace="catalog"/>
                                    </textFieldCell>
                                </textField>
                                <popUpButton id="g43" userLabel="GormNSPopUpButton">
                                    <rect key="frame" x="120" y="301" width="174" height="21"/>
                                    <autoresizingMask key="autoresizingMask"/>
                                    <popUpButtonCell key="cell" type="push" bezelStyle="rounded" alignment="left" lineBreakMode="truncatingTail" borderStyle="borderAndBezel" imageScaling="proportionallyDown" inset="2" id="g45">
                                        <behavior key="behavior" lightByBackground="YES" lightByGray="YES"/>
                                        <font key="font" metaFont="system"/>
                                        <menu key="menu" title="" id="g46">
                                            <items>
                                                <menuItem title="Item 1" image="common_Nibble" id="g48"/>
                                                <menuItem title="Item 2" id="g52"/>
                                                <menuItem title="Item 3" id="g54"/>
                                            </items>
                                        </menu>
                                    </popUpButtonCell>
                                    <connections>
                                        <action selector="setCurrentLanguage:" target="-2" id="x5"/>
                                    </connections>
                                </popUpButton>
                            </subviews>
                        </view>
                    </box>
                </subviews>
            </view>
        </window>
    </objects>
    <resources>
        <image name="common_Nibble" width="32" height="32"/>
    </resources>
</document>