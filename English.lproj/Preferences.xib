<?xml version="1.0" encoding="UTF-8"?>
<document type="com.apple.InterfaceBuilder3.Cocoa.XIB" version="3.0" toolsVersion="25503" targetRuntime="MacOSX.Cocoa" propertyAccessControl="none" useAutolayout="NO">
    <dependencies>
        <plugIn identifier="com.apple.InterfaceBuilder.CocoaPlugin" version="25503"/>
        <capability name="documents saved in the Xcode 8 format" minToolsVersion="8.0"/>
    </dependencies>
    <objects>
        <customObject id="-2" userLabel="File's Owner" customClass="PCPrefController">
            <connections>
                <outlet property="panel" destination="g3" id="x1"/>
                <outlet property="popupButton" destination="g7" id="x2"/>
                <outlet property="sectionsView" destination="g26" id="x3"/>
            </connections>
        </customObject>
        <customObject id="-1" userLabel="First Responder" customClass="FirstResponder"/>
        <customObject id="-3" userLabel="Application" customClass="NSObject"/>
        <window title="Preferences" allowsToolTipsWhenApplicationIsInactive="NO" autorecalculatesKeyViewLoop="NO" releasedWhenClosed="NO" oneShot="NO" visibleAtLaunch="NO" animationBehavior="default" id="g3" userLabel="Panel" customClass="NSPanel">
            <windowStyleMask key="styleMask" titled="YES" closable="YES"/>
            <windowPositionMask key="initialPositionMask" leftStrut="YES" bottomStrut="YES"/>
            <rect key="contentRect" x="1" y="9" width="330" height="302"/>
            <rect key="screenRect" x="0" y="0" width="1280" height="1024"/>
            <value key="minSize" type="size" width="1" height="32"/>
            <value key="maxSize" type="size" width="10000" height="10000"/>
            <view key="contentView" id="g5">
                <rect key="frame" x="0.0" y="0.0" width="330" height="302"/>
                <autoresizingMask key="autoresizingMask" widthSizable="YES" heightSizable="YES"/>
                <subviews>
                    <popUpButton id="g7" userLabel="GormNSPopUpButton">
                        <rect key="frame" x="67" y="272" width="197" height="20"/>
                        <autoresizingMask key="autoresizingMask"/>
                        <popUpButtonCell key="cell" type="push" bezelStyle="rounded" alignment="left" lineBreakMode="truncatingTail" borderStyle="borderAndBezel" imageScaling="proportionallyDown" inset="2" id="g9" selectedItem="g15">
                            <behavior key="behavior" lightByBackground="YES" lightByGray="YES"/>
                            <font key="font" metaFont="system"/>
                            <menu key="menu" title="" id="g12">
                                <items>
                                    <menuItem title="Item 1" state="on" image="common_Nibble" id="g15" userLabel="MenuItem"/>
                                    <menuItem title="Item 2" id="g20" userLabel="MenuItem1"/>
                                    <menuItem title="Item 3" id="g22" userLabel="MenuItem2"/>
                                </items>
                            </menu>
                        </popUpButtonCell>
                        <connections>
                            <action selector="popupChanged:" target="-2" id="x4"/>
                        </connections>
                    </popUpButton>
                    <box title="Box" titlePosition="noTitle" boxType="custom" borderType="line" id="g26" userLabel="Box">
                        <rect key="frame" x="-2" y="-2" width="334" height="263"/>
                        <autoresizingMask key="autoresizingMask"/>
                        <view key="contentView" id="g28">
                            <rect key="frame" x="1" y="1" width="332" height="261"/>
                            <autoresizingMask key="autoresizingMask"/>
                        </view>
                    </box>
                </subviews>
            </view>
        </window>
    </objects>
    <resources>
        <image name="common_Nibble" width="32" height="32"/>
    </resources>
</document>